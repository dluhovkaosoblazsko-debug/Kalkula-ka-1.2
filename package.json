{
  "name": "insolvencni-kalkulacka",
  "private": true,
  "version": "1.3.0",
  "description": "Kalkulačka srážek a oddlužení pro rok 2026",
  "author": "",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "node scripts/verifyCalculations.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.4",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "cz.kalkulacka.oddluzeni",
    "productName": "Kalkulačka srážek a oddlužení",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
